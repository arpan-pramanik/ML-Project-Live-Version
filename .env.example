# Coinbase API Configuration (Optional)
# Public Coinbase WebSocket feeds (ticker, matches, level2) do NOT require any API keys.
# If using private / authenticated Advanced Trade WebSocket endpoints, supply your credentials below.
# NEVER commit your actual .env file or private keys to git.

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_PRODUCT_ID=BTC-USD
